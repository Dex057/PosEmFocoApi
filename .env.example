# Copie para .env e preencha com valores reais. Nunca comite o .env.

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=posemfoco_user
DB_PASSWORD=sua_senha_segura
DB_NAME=posemfoco

# E-mail (Gmail) - use uma Senha de App: https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_aplicativo

# A cada quantos minutos o worker roda o scraper
INTERVALO_SCRAPER_MINUTOS=60

# URL(s) do frontend autorizadas a chamar a API, separadas por vírgula.
# Em produção NÃO deixe "*" — restrinja à(s) URL(s) reais (ex.: seu domínio na Vercel).
ALLOWED_ORIGINS=*
